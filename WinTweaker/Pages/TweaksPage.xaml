<Page x:Class="WinTweaker.Pages.TweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeWindow}">

    <Page.Resources>


    </Page.Resources>


    <!-- ========================================================= -->
    <!-- CONTENT -->
    <!-- ========================================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <!-- ИЗМЕНЕНО: 30 -> 40 -->

        <Grid Margin="40">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,25">

                <TextBlock
                    Text="Tweaks"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{DynamicResource ThemeText}"/>

                <TextBlock
                    Text="Игровой режим, параметры экрана и сети."
                    FontSize="14"
                    Foreground="{DynamicResource ThemeMuted}"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- GAME MODE -->
            <!-- ================================================= -->

            <Border
                Grid.Row="1"
                Background="{DynamicResource ThemeCard}"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="🎮 Game Mode"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ThemeText}"/>

                        <TextBlock
                            Text="Включает игровой режим Windows для игр."
                            FontSize="13"
                            Foreground="{DynamicResource ThemeMuted}"
                            Margin="0,7,0,10"/>

                        <TextBlock
                            x:Name="GameModeStatusText"
                            Text="Проверка..."
                            FontSize="14"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                    <Button
                        x:Name="GameModeButton"
                        Grid.Column="1"
                        Content="Переключить"
                        Width="140"
                        Height="42"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="GameModeButton_Click"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- DISPLAY -->
            <!-- ================================================= -->

            <Border
                Grid.Row="2"
                Background="{DynamicResource ThemeCard}"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="🖥 Режим растяжения"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThemeText}"/>

                    <TextBlock
                        Text="Меняет разрешение только основного монитора."
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,7,0,3"/>

                    <TextBlock
                        Text="Второй монитор не изменяется."
                        FontSize="12"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,0,0,18"/>


                    <Border
                        Background="{DynamicResource ThemeWindow}"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,16">

                        <StackPanel>

                            <TextBlock
                                Text="Текущий режим"
                                FontSize="12"
                                Foreground="{DynamicResource ThemeMuted}"/>

                            <TextBlock
                                x:Name="CurrentResolutionText"
                                Text="Проверка..."
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ThemeText}"
                                Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>


                    <TextBlock
                        Text="Игровое разрешение"
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,0,0,7"/>

                    <ComboBox
                        x:Name="StretchResolutionComboBox"
                        Height="42"
                        Margin="0,0,0,18"
                        DisplayMemberPath="DisplayName"/>


                    <StackPanel Orientation="Horizontal">

                        <Button
                            x:Name="StretchButton"
                            Content="Включить растяжение"
                            Width="190"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="StretchButton_Click"/>

                        <Button
                            x:Name="RestoreResolutionButton"
                            Content="Вернуть исходное"
                            Width="160"
                            Height="42"
                            Click="RestoreResolutionButton_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- NETWORK -->
            <!-- ================================================= -->

            <Border
                Grid.Row="3"
                Background="{DynamicResource ThemeCard}"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="🌐 Сеть"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThemeText}"/>

                    <TextBlock
                        Text="Управление сетевыми адаптерами и сетевыми компонентами Windows."
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,7,0,18"/>


                    <TextBlock
                        Text="Сетевой адаптер"
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,0,0,7"/>

                    <ComboBox
                        x:Name="NetworkAdapterComboBox"
                        Height="42"
                        Margin="0,0,0,10"
                        DisplayMemberPath="Name"
                        SelectionChanged="NetworkAdapterComboBox_SelectionChanged"/>


                    <TextBlock
                        x:Name="NetworkAdapterStatusText"
                        Text="Адаптер не выбран"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,0,0,14"/>


                    <Button
                        x:Name="NetworkAdapterToggleButton"
                        Content="Включить / выключить"
                        Width="230"
                        Height="42"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,22"
                        Click="NetworkAdapterToggleButton_Click"/>


                    <TextBlock
                        Text="Текущий DNS"
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,0,0,7"/>


                    <Border
                        Background="{DynamicResource ThemeWindow}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,16">

                        <TextBlock
                            x:Name="CurrentDnsText"
                            Text="Проверка..."
                            FontSize="13"
                            Foreground="{DynamicResource ThemeText}"
                            TextWrapping="Wrap"/>

                    </Border>


                    <TextBlock
                        Text="DNS-пресет"
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,0,0,7"/>


                    <ComboBox
                        x:Name="DnsPresetComboBox"
                        Height="42"
                        Margin="0,0,0,10"
                        DisplayMemberPath="DisplayName"/>


                    <TextBlock
                        Text="Выбери готовый DNS-сервер для выбранного адаптера."
                        FontSize="12"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,0,0,12"/>


                    <Button
                        x:Name="ApplyDnsButton"
                        Content="Применить DNS"
                        Width="160"
                        Height="42"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,22"
                        Click="ApplyDnsButton_Click"/>


                    <WrapPanel>

                        <Button
                            Content="🧹 Очистить DNS"
                            Width="150"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="FlushDnsButton_Click"/>

                        <Button
                            Content="🔄 Сбросить Winsock"
                            Width="170"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="ResetWinsockButton_Click"/>

                        <Button
                            Content="🔄 Сбросить TCP/IP"
                            Width="170"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="ResetTcpIpButton_Click"/>

                        <Button
                            Content="↻ Обновить"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="RefreshNetworkButton_Click"/>

                    </WrapPanel>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>