<Page x:Class="WinTweaker.Pages.TweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F0F12">

    <Page.Resources>

        <!-- ===================================================== -->
        <!-- COMBOBOX ITEM -->
        <!-- ===================================================== -->

        <Style TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#25252C"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Style.Triggers>

                <Trigger Property="IsHighlighted"
                         Value="True">

                    <Setter Property="Background"
                            Value="#34343D"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3A3A46"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- COMBOBOX -->
        <!-- ===================================================== -->

        <Style TargetType="ComboBox">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#25252C"/>

            <Setter Property="BorderBrush"
                    Value="#383842"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- ================================================= -->
                            <!-- ЗАКРЫТАЯ СТРОКА -->
                            <!-- ================================================= -->

                            <Border x:Name="MainBorder"
                                    Background="#25252C"
                                    BorderBrush="#383842"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="10,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="{Binding SelectedItem.DisplayName,
                                                RelativeSource={RelativeSource TemplatedParent}}"/>

                                    <Path
                                        Grid.Column="1"
                                        Width="12"
                                        Height="7"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 0 0 L 6 6 L 12 0"
                                        Stroke="White"
                                        StrokeThickness="1.5"
                                        Fill="Transparent"/>

                                    <ToggleButton
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen,
                                                            RelativeSource={RelativeSource TemplatedParent},
                                                            Mode=TwoWay}"/>

                                </Grid>

                            </Border>


                            <!-- ================================================= -->
                            <!-- ВЫПАДАЮЩИЙ СПИСОК -->
                            <!-- ================================================= -->

                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Fade">

                                <Border
                                    Background="#25252C"
                                    BorderBrush="#383842"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth,
                                                       RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer
                                        MaxHeight="320"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">

                                        <ItemsPresenter/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="#4A4A56"/>

                            </Trigger>

                            <Trigger Property="IsDropDownOpen"
                                     Value="True">

                                <Setter TargetName="MainBorder"
                                        Property="BorderBrush"
                                        Value="#5A5A68"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="MainBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- BUTTON -->
        <!-- ===================================================== -->

        <Style TargetType="Button">

            <Setter Property="Background"
                    Value="#25252C"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#383842"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#303039"/>

                    <Setter Property="BorderBrush"
                            Value="#4A4A56"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#3A3A46"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter Property="Opacity"
                            Value="0.5"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Page.Resources>


    <!-- ========================================================= -->
    <!-- CONTENT -->
    <!-- ========================================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <!-- ИЗМЕНЕНО: 30 -> 40 -->

        <Grid Margin="40">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,25">

                <TextBlock
                    Text="Tweaks"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Text="Оптимизация и игровые настройки Windows"
                    FontSize="14"
                    Foreground="#888890"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- GAME MODE -->
            <!-- ================================================= -->

            <Border
                Grid.Row="1"
                Background="#18181D"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            Text="🎮 Game Mode"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                        <TextBlock
                            Text="Включает игровой режим Windows для игр."
                            FontSize="13"
                            Foreground="#9999A3"
                            Margin="0,7,0,10"/>

                        <TextBlock
                            x:Name="GameModeStatusText"
                            Text="Проверка..."
                            FontSize="14"
                            FontWeight="SemiBold"/>

                    </StackPanel>

                    <Button
                        x:Name="GameModeButton"
                        Grid.Column="1"
                        Content="Переключить"
                        Width="140"
                        Height="42"
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Click="GameModeButton_Click"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- DISPLAY -->
            <!-- ================================================= -->

            <Border
                Grid.Row="2"
                Background="#18181D"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="🖥 Режим растяжения"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Меняет разрешение только основного монитора."
                        FontSize="13"
                        Foreground="#9999A3"
                        Margin="0,7,0,3"/>

                    <TextBlock
                        Text="Второй монитор не изменяется."
                        FontSize="12"
                        Foreground="#686872"
                        Margin="0,0,0,18"/>


                    <Border
                        Background="#121216"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,16">

                        <StackPanel>

                            <TextBlock
                                Text="Текущий режим"
                                FontSize="12"
                                Foreground="#777782"/>

                            <TextBlock
                                x:Name="CurrentResolutionText"
                                Text="Проверка..."
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>


                    <TextBlock
                        Text="Игровое разрешение"
                        FontSize="13"
                        Foreground="#AAAAAF"
                        Margin="0,0,0,7"/>

                    <ComboBox
                        x:Name="StretchResolutionComboBox"
                        Height="42"
                        Margin="0,0,0,18"
                        DisplayMemberPath="DisplayName"/>


                    <StackPanel Orientation="Horizontal">

                        <Button
                            x:Name="StretchButton"
                            Content="Включить растяжение"
                            Width="190"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="StretchButton_Click"/>

                        <Button
                            x:Name="RestoreResolutionButton"
                            Content="Вернуть исходное"
                            Width="160"
                            Height="42"
                            Click="RestoreResolutionButton_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- NETWORK -->
            <!-- ================================================= -->

            <Border
                Grid.Row="3"
                Background="#18181D"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="🌐 Сеть"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Управление сетевыми адаптерами и сетевыми компонентами Windows."
                        FontSize="13"
                        Foreground="#9999A3"
                        Margin="0,7,0,18"/>


                    <TextBlock
                        Text="Сетевой адаптер"
                        FontSize="13"
                        Foreground="#AAAAAF"
                        Margin="0,0,0,7"/>

                    <ComboBox
                        x:Name="NetworkAdapterComboBox"
                        Height="42"
                        Margin="0,0,0,10"
                        DisplayMemberPath="Name"
                        SelectionChanged="NetworkAdapterComboBox_SelectionChanged"/>


                    <TextBlock
                        x:Name="NetworkAdapterStatusText"
                        Text="Адаптер не выбран"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#9999A3"
                        Margin="0,0,0,14"/>


                    <Button
                        x:Name="NetworkAdapterToggleButton"
                        Content="Включить / выключить"
                        Width="230"
                        Height="42"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,22"
                        Click="NetworkAdapterToggleButton_Click"/>


                    <TextBlock
                        Text="Текущий DNS"
                        FontSize="13"
                        Foreground="#AAAAAF"
                        Margin="0,0,0,7"/>


                    <Border
                        Background="#121216"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,16">

                        <TextBlock
                            x:Name="CurrentDnsText"
                            Text="Проверка..."
                            FontSize="13"
                            Foreground="White"
                            TextWrapping="Wrap"/>

                    </Border>


                    <TextBlock
                        Text="DNS-пресет"
                        FontSize="13"
                        Foreground="#AAAAAF"
                        Margin="0,0,0,7"/>


                    <ComboBox
                        x:Name="DnsPresetComboBox"
                        Height="42"
                        Margin="0,0,0,10"
                        DisplayMemberPath="DisplayName"/>


                    <TextBlock
                        Text="Выбери готовый DNS-сервер для выбранного адаптера."
                        FontSize="12"
                        Foreground="#686872"
                        Margin="0,0,0,12"/>


                    <Button
                        x:Name="ApplyDnsButton"
                        Content="Применить DNS"
                        Width="160"
                        Height="42"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,22"
                        Click="ApplyDnsButton_Click"/>


                    <WrapPanel>

                        <Button
                            Content="🧹 Очистить DNS"
                            Width="150"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="FlushDnsButton_Click"/>

                        <Button
                            Content="🔄 Сбросить Winsock"
                            Width="170"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="ResetWinsockButton_Click"/>

                        <Button
                            Content="🔄 Сбросить TCP/IP"
                            Width="170"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="ResetTcpIpButton_Click"/>

                        <Button
                            Content="↻ Обновить"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="RefreshNetworkButton_Click"/>

                    </WrapPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- CLEANUP -->
            <!-- ================================================= -->

            <Border
                Grid.Row="4"
                Background="#18181D"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="🧹 Очистка"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Очистка временных файлов и системных кэшей."
                        FontSize="13"
                        Foreground="#9999A3"
                        Margin="0,7,0,18"/>


                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="52"/>
                        </Grid.RowDefinitions>


                        <!-- USER TEMP -->

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Временные файлы пользователя"
                                FontSize="14"
                                Foreground="White"/>

                            <TextBlock
                                Text="%TEMP%"
                                FontSize="11"
                                Foreground="#686872"/>

                        </StackPanel>

                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="Очистить"
                            Width="110"
                            Height="36"
                            Margin="15,0,0,0"
                            Click="CleanUserTempButton_Click"/>


                        <!-- WINDOWS TEMP -->

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Windows Temp"
                                FontSize="14"
                                Foreground="White"/>

                            <TextBlock
                                Text="C:\Windows\Temp"
                                FontSize="11"
                                Foreground="#686872"/>

                        </StackPanel>

                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="Очистить"
                            Width="110"
                            Height="36"
                            Margin="15,0,0,0"
                            Click="CleanWindowsTempButton_Click"/>


                        <!-- DIRECTX -->

                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="DirectX Shader Cache"
                                FontSize="14"
                                Foreground="White"/>

                            <TextBlock
                                Text="Кэш шейдеров DirectX"
                                FontSize="11"
                                Foreground="#686872"/>

                        </StackPanel>

                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Content="Очистить"
                            Width="110"
                            Height="36"
                            Margin="15,0,0,0"
                            Click="CleanDirectXShaderCacheButton_Click"/>


                        <!-- THUMBNAILS -->

                        <StackPanel
                            Grid.Row="3"
                            Grid.Column="0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Кэш миниатюр"
                                FontSize="14"
                                Foreground="White"/>

                            <TextBlock
                                Text="Эскизы изображений и видео"
                                FontSize="11"
                                Foreground="#686872"/>

                        </StackPanel>

                        <Button
                            Grid.Row="3"
                            Grid.Column="1"
                            Content="Очистить"
                            Width="110"
                            Height="36"
                            Margin="15,0,0,0"
                            Click="CleanThumbnailCacheButton_Click"/>


                        <!-- ICONS -->

                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Кэш значков"
                                FontSize="14"
                                Foreground="White"/>

                            <TextBlock
                                Text="Кэш значков Windows"
                                FontSize="11"
                                Foreground="#686872"/>

                        </StackPanel>

                        <Button
                            Grid.Row="4"
                            Grid.Column="1"
                            Content="Очистить"
                            Width="110"
                            Height="36"
                            Margin="15,0,0,0"
                            Click="CleanIconCacheButton_Click"/>


                        <!-- DELIVERY -->

                        <StackPanel
                            Grid.Row="5"
                            Grid.Column="0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Delivery Optimization"
                                FontSize="14"
                                Foreground="White"/>

                            <TextBlock
                                Text="Кэш доставки обновлений Windows"
                                FontSize="11"
                                Foreground="#686872"/>

                        </StackPanel>

                        <Button
                            Grid.Row="5"
                            Grid.Column="1"
                            Content="Очистить"
                            Width="110"
                            Height="36"
                            Margin="15,0,0,0"
                            Click="CleanDeliveryOptimizationButton_Click"/>


                        <!-- RECYCLE -->

                        <StackPanel
                            Grid.Row="6"
                            Grid.Column="0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Корзина"
                                FontSize="14"
                                Foreground="White"/>

                            <TextBlock
                                Text="Безвозвратное удаление содержимого корзины"
                                FontSize="11"
                                Foreground="#686872"/>

                        </StackPanel>

                        <Button
                            Grid.Row="6"
                            Grid.Column="1"
                            Content="Очистить"
                            Width="110"
                            Height="36"
                            Margin="15,0,0,0"
                            Click="EmptyRecycleBinButton_Click"/>

                    </Grid>


                    <!-- SAFE CLEANUP -->

                    <Border
                        Background="#121216"
                        BorderBrush="#383842"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,22,0,0">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel
                                Grid.Column="0">

                                <TextBlock
                                    Text="🧹 Безопасная очистка"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                                <TextBlock
                                    Text="Очищает временные файлы и системные кэши. Пользовательские документы не затрагиваются."
                                    FontSize="12"
                                    Foreground="#888890"
                                    TextWrapping="Wrap"
                                    Margin="0,5,15,0"/>

                            </StackPanel>


                            <Button
                                Grid.Column="1"
                                Content="Запустить"
                                Width="140"
                                Height="42"
                                VerticalAlignment="Center"
                                Click="SafeCleanupButton_Click"/>

                        </Grid>

                    </Border>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- SYSTEM -->
            <!-- ================================================= -->

            <Border
                Grid.Row="5"
                Background="#18181D"
                CornerRadius="14"
                Padding="22">

                <StackPanel>

                    <TextBlock
                        Text="⚙️ Система"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Быстрые системные действия и запуск встроенных компонентов Windows."
                        FontSize="13"
                        Foreground="#9999A3"
                        Margin="0,7,0,18"/>


                    <!-- ================================================= -->
                    <!-- EXPLORER -->
                    <!-- ================================================= -->

                    <Border
                        Background="#121216"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,12">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel
                                Grid.Column="0">

                                <TextBlock
                                    Text="🔄 Windows Explorer"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="White"/>

                                <TextBlock
                                    Text="Перезапускает оболочку Windows, рабочий стол и Проводник."
                                    FontSize="12"
                                    Foreground="#777782"
                                    Margin="0,4,15,0"/>

                            </StackPanel>


                            <Button
                                Grid.Column="1"
                                Content="Перезапустить"
                                Width="150"
                                Height="40"
                                VerticalAlignment="Center"
                                Click="RestartExplorerButton_Click"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- CACHE -->
                    <!-- ================================================= -->

                    <Border
                        Background="#121216"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,18">

                        <StackPanel>

                            <TextBlock
                                Text="Кэш Windows"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Margin="0,0,0,12"/>

                            <WrapPanel>

                                <Button
                                    Content="🖼 Кэш значков"
                                    Width="170"
                                    Height="40"
                                    Margin="0,0,10,10"
                                    Click="CleanSystemIconCacheButton_Click"/>

                                <Button
                                    Content="🖼 Кэш миниатюр"
                                    Width="180"
                                    Height="40"
                                    Margin="0,0,10,10"
                                    Click="CleanSystemThumbnailCacheButton_Click"/>

                            </WrapPanel>

                        </StackPanel>

                    </Border>


                    <!-- ================================================= -->
                    <!-- QUICK LAUNCH -->
                    <!-- ================================================= -->

                    <TextBlock
                        Text="🛠 Быстрый запуск"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Margin="0,0,0,12"/>


                    <TextBlock
                        Text="Быстрый доступ к системным компонентам Windows."
                        FontSize="12"
                        Foreground="#777782"
                        Margin="0,0,0,14"/>


                    <WrapPanel>

                        <Button
                            Tag="TaskManager"
                            Content="Диспетчер задач"
                            Width="175"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="LaunchSystemComponentButton_Click"/>

                        <Button
                            Tag="DeviceManager"
                            Content="Диспетчер устройств"
                            Width="185"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="LaunchSystemComponentButton_Click"/>

                        <Button
                            Tag="DiskManagement"
                            Content="Управление дисками"
                            Width="180"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="LaunchSystemComponentButton_Click"/>

                        <Button
                            Tag="Services"
                            Content="Службы"
                            Width="120"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="LaunchSystemComponentButton_Click"/>

                        <Button
                            Tag="EventViewer"
                            Content="Просмотр событий"
                            Width="165"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="LaunchSystemComponentButton_Click"/>

                        <Button
                            Tag="ResourceMonitor"
                            Content="Монитор ресурсов"
                            Width="175"
                            Height="42"
                            Margin="0,0,10,10"
                            Click="LaunchSystemComponentButton_Click"/>

                        <Button
                            Tag="SystemProperties"
                            Content="Свойства системы"
                            Width="165"
