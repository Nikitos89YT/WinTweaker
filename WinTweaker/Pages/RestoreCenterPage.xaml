<Page x:Class="WinTweaker.Pages.RestoreCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeWindow}" Foreground="{DynamicResource ThemeText}">
    <Page.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCard}"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Description" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,14"/>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30">
            <TextBlock Text="Восстановление" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Точки Windows, копии настроек и отмена изменений WinTweaker." Style="{StaticResource Description}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Точки восстановления Windows" Style="{StaticResource Heading}"/>
                    <TextBlock Text="Для создания точки нужна включённая защита системы. Выбор точки и восстановление выполняются в мастере Windows." Style="{StaticResource Description}"/>
                    <WrapPanel>
                        <Button x:Name="CreatePointButton" Content="Создать точку" Click="CreatePoint_Click"/>
                        <Button Content="Открыть мастер Windows" Click="OpenWizard_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="PointStatus" TextWrapping="Wrap" Foreground="{DynamicResource ThemeMuted}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Настройки WinTweaker" Style="{StaticResource Heading}"/>
                    <TextBlock Text="JSON-копия содержит настройки приложения, а не настройки Windows и не историю отката." Style="{StaticResource Description}"/>
                    <WrapPanel>
                        <Button Content="Экспортировать настройки" Click="ExportSettings_Click"/>
                        <Button Content="Импортировать настройки" Click="ImportSettings_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Откат твиков" Style="{StaticResource Heading}"/>
                    <TextBlock Text="Последнее изменение игрового режима можно отменить после перезапуска WinTweaker. Исходное разрешение доступно только до закрытия программы. Сетевые изменения не откатываются." Style="{StaticResource Description}"/>
                    <WrapPanel>
                        <Button x:Name="UndoGameModeButton" Content="Откатить игровой режим" Click="UndoGameMode_Click"/>
                        <Button x:Name="UndoDisplayButton" Content="Вернуть исходное разрешение" Click="UndoDisplay_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
