<Page x:Class="WinTweaker.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F1115">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30">

            <!-- ===================================================== -->
            <!-- ЗАГОЛОВОК -->
            <!-- ===================================================== -->

            <TextBlock Text="Добро пожаловать"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Настройка и обслуживание Windows"
                       FontSize="14"
                       Foreground="#7F8796"
                       Margin="0,7,0,30"/>


            <!-- ===================================================== -->
            <!-- БЫСТРЫЙ ДОСТУП -->
            <!-- ===================================================== -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- TWEAKS -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="25">

                    <StackPanel HorizontalAlignment="Stretch">

                        <!-- Иконка -->

                        <Grid Height="36"
                              HorizontalAlignment="Stretch">

                            <Path Width="30"
                                  Height="36"
                                  Fill="White"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Data="M17,0 L4,19 L12,19 L9,36 L27,14 L18,14 Z"/>

                        </Grid>


                        <!-- Название -->

                        <TextBlock Text="Tweaks"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,5"
                                   HorizontalAlignment="Left"/>


                        <!-- Описание -->

                        <TextBlock Text="Настройки производительности, Gaming и Windows."
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="#8E96A5"
                                   HorizontalAlignment="Left"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- UNLOCKER -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="25">

                    <StackPanel HorizontalAlignment="Stretch">

                        <!-- Иконка -->

                        <Grid Height="36"
                              HorizontalAlignment="Stretch">

                            <Path Width="30"
                                  Height="36"
                                  Fill="White"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Data="M7,14 L7,9 C7,4 10,1 15,1 C20,1 23,4 23,9 L23,14 L27,14 L27,35 L3,35 L3,14 Z M11,14 L19,14 L19,9 C19,6.5 17.5,5 15,5 C12.5,5 11,6.5 11,9 Z"/>

                        </Grid>


                        <!-- Название -->

                        <TextBlock Text="Unlocker"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,15,0,5"
                                   HorizontalAlignment="Left"/>


                        <!-- Описание -->

                        <TextBlock Text="Поиск и восстановление системных ограничений Windows."
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="#8E96A5"
                                   HorizontalAlignment="Left"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- ИНФОРМАЦИЯ О СИСТЕМЕ -->
            <!-- ===================================================== -->

            <TextBlock Text="▣  Информация о системе"
                       FontFamily="Segoe UI Symbol"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,25,0,15"
                       HorizontalAlignment="Left"/>


            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="135"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- CPU -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="CPU"
                                   FontSize="13"
                                   Foreground="#7F8796"/>

                        <TextBlock x:Name="CpuText"
                                   Text="Загрузка..."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- GPU -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="GPU"
                                   FontSize="13"
                                   Foreground="#7F8796"/>

                        <TextBlock x:Name="GpuText"
                                   Text="Загрузка..."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- RAM -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Оперативная память"
                                   FontSize="13"
                                   Foreground="#7F8796"/>

                        <TextBlock x:Name="RamText"
                                   Text="Загрузка..."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- WINDOWS -->
                <!-- ================================================= -->

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Windows"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8796"/>

                        <TextBlock x:Name="WindowsText"
                                   Text="Загрузка..."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- MOTHERBOARD -->
                <!-- ================================================= -->

                <Border Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Материнская плата"
                                   FontSize="13"
                                   Foreground="#7F8796"/>

                        <TextBlock x:Name="MotherboardText"
                                   Text="Загрузка..."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- МОНИТОРИНГ -->
            <!-- ===================================================== -->

            <TextBlock Text="▥  Мониторинг"
                       FontFamily="Segoe UI Symbol"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,25,0,15"
                       HorizontalAlignment="Left"/>


            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- CPU MONITORING -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="CPU"
                                   FontSize="13"
                                   Foreground="#7F8796"/>

                        <TextBlock x:Name="CpuUsageText"
                                   Text="0%"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,7,0,5"/>

                        <ProgressBar x:Name="CpuProgress"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- RAM MONITORING -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="RAM"
                                   FontSize="13"
                                   Foreground="#7F8796"/>

                        <TextBlock x:Name="RamUsageText"
                                   Text="0%"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,7,0,5"/>

                        <ProgressBar x:Name="RamProgress"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- GPU MONITORING -->
                <!-- ================================================= -->

                <Border Grid.Column="4"
                        Background="#181C23"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="GPU"
                                   FontSize="13"
                                   Foreground="#7F8796"/>

                        <TextBlock x:Name="GpuUsageText"
                                   Text="0%"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,7,0,5"/>

                        <ProgressBar x:Name="GpuProgress"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</Page>