<Page x:Class="WinTweaker.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeWindow}">

    <Page.Resources>



        <!-- ===================================================== -->
        <!-- CHECKBOX -->
        <!-- ===================================================== -->

        <Style TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="{DynamicResource ThemeText}"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Margin"
                    Value="0,0,0,14"/>

        </Style>

    </Page.Resources>


    <!-- ========================================================= -->
    <!-- CONTENT -->
    <!-- ========================================================= -->

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30">


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <StackPanel Margin="0,0,0,25">

                <TextBlock
                    Text="Настройки"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{DynamicResource ThemeText}"/>

                <TextBlock
                    Text="Изменения сохраняются автоматически."
                    FontSize="14"
                    Foreground="{DynamicResource ThemeMuted}"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- INTERFACE -->
            <!-- ================================================= -->

            <Border
                Background="{DynamicResource ThemeCard}"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="🎨 Интерфейс"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThemeText}"/>

                    <TextBlock
                        Text="Внешний вид приложения."
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,7,0,20"/>


                    <CheckBox Click="Setting_Click"
                        x:Name="DarkThemeCheckBox"
                        Content="Тёмная тема"/>


                    <TextBlock
                        Text="Акцентный цвет"
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,0,0,7"/>


                    <ComboBox
                        x:Name="AccentColorComboBox"
                        SelectedValuePath="Tag"
                        Margin="0,0,0,0"
                        SelectionChanged="AccentColorComboBox_SelectionChanged">

                        <ComboBox.Resources>
                            <DataTemplate x:Key="AccentSwatch">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="Swatch" Width="12" Height="12" Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="Синий">
                                        <Setter TargetName="Swatch" Property="Fill" Value="#629BFF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Фиолетовый">
                                        <Setter TargetName="Swatch" Property="Fill" Value="#B58AF5"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Зелёный">
                                        <Setter TargetName="Swatch" Property="Fill" Value="#60C988"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Оранжевый">
                                        <Setter TargetName="Swatch" Property="Fill" Value="#FFAD62"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding}" Value="Красный">
                                        <Setter TargetName="Swatch" Property="Fill" Value="#FA7480"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.Resources>
                        <ComboBoxItem ContentTemplate="{StaticResource AccentSwatch}" Tag="Blue" Content="Синий"/>
                        <ComboBoxItem ContentTemplate="{StaticResource AccentSwatch}" Tag="Purple" Content="Фиолетовый"/>
                        <ComboBoxItem ContentTemplate="{StaticResource AccentSwatch}" Tag="Green" Content="Зелёный"/>
                        <ComboBoxItem ContentTemplate="{StaticResource AccentSwatch}" Tag="Orange" Content="Оранжевый"/>
                        <ComboBoxItem ContentTemplate="{StaticResource AccentSwatch}" Tag="Red" Content="Красный"/>
                    </ComboBox>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- BEHAVIOR -->
            <!-- ================================================= -->

            <Border
                Background="{DynamicResource ThemeCard}"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="⚙️ Поведение"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThemeText}"/>

                    <TextBlock
                        Text="Как WinTweaker должен выполнять действия."
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,7,0,20"/>


                    <CheckBox Click="Setting_Click"
                        x:Name="ConfirmDangerousActionsCheckBox"
                        Content="Показывать подтверждение перед потенциально опасными действиями"/>


                    <CheckBox Click="Setting_Click"
                        x:Name="RunAsAdministratorCheckBox"
                        Content="Запрашивать права администратора при запуске"/>


                    <CheckBox Click="Setting_Click"
                        x:Name="ShowNotificationsCheckBox"
                        Content="Показывать уведомления"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- STARTUP -->
            <!-- ================================================= -->

            <Border
                Background="{DynamicResource ThemeCard}"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="🚀 Автозагрузка"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThemeText}"/>

                    <TextBlock
                        Text="Настройки отображения страницы автозагрузки."
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,7,0,20"/>


                    <CheckBox Click="Setting_Click"
                        x:Name="SaveStartupColumnsCheckBox"
                        Content="Сохранять ширину колонок"/>


                    <CheckBox Click="Setting_Click"
                        x:Name="SaveStartupColumnOrderCheckBox"
                        Content="Сохранять порядок колонок"/>


                    <CheckBox Click="Setting_Click"
                        x:Name="ShowSystemStartupItemsCheckBox"
                        Content="Показывать системные записи"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- SECURITY -->
            <!-- ================================================= -->

            <Border
                Background="{DynamicResource ThemeCard}"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="🛡 Безопасность"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThemeText}"/>

                    <TextBlock
                        Text="Дополнительная защита перед изменениями системы."
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,7,0,20"/>


                    <CheckBox Click="Setting_Click"
                        x:Name="CreateRestorePointCheckBox"
                        Content="Создавать точку восстановления перед применением твиков"/>


                    <CheckBox Click="Setting_Click"
                        x:Name="BackupBeforeChangesCheckBox"
                        Content="Сохранять предыдущие настройки WinTweaker перед изменением"/>


                    <Border
                        Background="{DynamicResource ThemeWindow}"
                        BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,5,0,0">

                        <TextBlock
                            Text="Копия settings.previous.json хранится рядом с settings.json. Её можно импортировать во вкладке «Восстановление»."
                            FontSize="12"
                            Foreground="{DynamicResource ThemeMuted}"
                            TextWrapping="Wrap"/>

                    </Border>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- ABOUT -->
            <!-- ================================================= -->

            <Border
                Background="{DynamicResource ThemeCard}"
                CornerRadius="14"
                Padding="22"
                Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock
                        Text="ℹ️ О программе"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThemeText}"/>


                    <TextBlock
                        Text="WinTweaker"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ThemeText}"
                        Margin="0,16,0,3"/>


                    <TextBlock
                        Text="Windows Utility"
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"/>


                    <TextBlock
                        Text="Версия 1.0.0"
                        FontSize="13"
                        Foreground="{DynamicResource ThemeMuted}"
                        Margin="0,3,0,18"/>


                    <!-- AUTHORS -->

                    <Border
                        Background="{DynamicResource ThemeWindow}"
                        BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,15">

                        <StackPanel>

                            <TextBlock
                                Text="Разработчики"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ThemeText}"
                                Margin="0,0,0,10"/>


                            <TextBlock
                                Text="Автор-кодер: Fifiv"
                                FontSize="13"
                                Foreground="{DynamicResource ThemeText}"
                                Margin="0,0,0,5"/>


                            <TextBlock
                                Text="Соавтор: Moment1k"
                                FontSize="13"
                                Foreground="{DynamicResource ThemeText}"/>

                        </StackPanel>

                    </Border>


                    <!-- COPYRIGHT -->

                    <Border
                        Background="{DynamicResource ThemeWindow}"
                        BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,0,0,15">

                        <TextBlock
                            Text="© Авторские права на WinTweaker принадлежат Fifiv."
                            FontSize="13"
                            Foreground="{DynamicResource ThemeMuted}"
                            TextWrapping="Wrap"/>

                    </Border>


                    <Button
                        Content="📂 Открыть файл настроек"
                        Width="190"
                        Height="40"
                        HorizontalAlignment="Left"
                        Click="OpenSettingsFileButton_Click"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- ACTIONS -->
            <!-- ================================================= -->

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,0,0,25">

                <Button
                    x:Name="ResetSettingsButton"
                    Content="Сбросить"
                    Width="130"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="ResetSettingsButton_Click"/>


                <Button
                    x:Name="SaveSettingsButton"
                    Content="Сохранить настройки"
                    Width="190"
                    Height="42"
                    Click="SaveSettingsButton_Click"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</Page>