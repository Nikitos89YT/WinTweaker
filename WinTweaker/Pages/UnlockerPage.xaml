<Page x:Class="WinTweaker.Pages.UnlockerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="clr-namespace:WinTweaker.Components"
      Background="{DynamicResource ThemeWindow}">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30">


            <!-- ===================================================== -->
            <!-- HEADER -->
            <!-- ===================================================== -->

            <StackPanel Margin="0,0,0,30">

                <TextBlock
                    Text="🔓 Unlocker"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{DynamicResource ThemeText}"/>

                <TextBlock
                    Text="Проверка и восстановление доступа к инструментам Windows для текущего пользователя"
                    FontSize="14"
                    Foreground="{DynamicResource ThemeMuted}"
                    TextWrapping="Wrap"
                    Margin="0,7,0,0"/>

            </StackPanel>


            <!-- ===================================================== -->
            <!-- SYSTEM RESTRICTIONS -->
            <!-- ===================================================== -->

            <Button Content="Комплексная проверка и разблокировка"
                    HorizontalAlignment="Left" Padding="16,9"
                    Margin="0,0,0,8" Style="{StaticResource ActionButtonStyle}"
                    Click="CheckAll_Click"/>
            <TextBlock x:Name="BatchResult" TextWrapping="Wrap"
                       Foreground="{DynamicResource ThemeText}" Margin="0,0,0,16"
                       AutomationProperties.LiveSetting="Polite"/>

            <TextBlock
                Text="Системные ограничения"
                FontSize="20"
                FontWeight="Bold"
                Foreground="{DynamicResource ThemeText}"
                Margin="0,0,0,15"/>


            <components:UnlockerCard
                x:Name="TaskManagerCard"
                Title="Диспетчер задач"
                Description="Проверяет и восстанавливает доступ к Диспетчеру задач Windows."
                Status="Проверка..."
                ButtonText="Проверить"
                ActionClicked="TaskManagerCard_ActionClicked"
                Margin="0,0,0,18"/>


            <StackPanel x:Name="PolicyCards"/>
        </StackPanel>

    </ScrollViewer>

</Page>
