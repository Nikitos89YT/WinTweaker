<Page x:Class="WinTweaker.Pages.WindowsAppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeWindow}" Loaded="Page_Loaded">
    <DockPanel Margin="30">
        <StackPanel DockPanel.Dock="Top">
            <Button Content="‹ Инструменты" Padding="12,8" HorizontalAlignment="Left" Click="Back_Click"/>
            <TextBlock Text="Приложения Windows" Foreground="{DynamicResource ThemeText}" FontSize="30" FontWeight="Bold" Margin="0,12,0,6"/>
            <TextBlock Text="Выберите стандартное приложение для текущей учётной записи." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel>
                <Button x:Name="ChangeButton" Content="Удалить" Padding="16,10" IsEnabled="False" Click="Change_Click"/>
                <Button x:Name="StoreButton" Content="Установить из Store" Padding="16,10" Margin="8,0" Visibility="Collapsed" Click="Store_Click"/>
                <Button x:Name="RefreshButton" Content="Обновить список" Padding="16,10" Click="Refresh_Click"/>
            </WrapPanel>
            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Notice" Foreground="{DynamicResource ThemeText}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
            </ScrollViewer>
        </StackPanel>
        <ListBox x:Name="Apps" Background="{DynamicResource ThemeCard}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}"
                 HorizontalContentAlignment="Stretch" SelectionChanged="Selection_Changed" AutomationProperties.Name="Приложения Windows">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="10,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Page>
