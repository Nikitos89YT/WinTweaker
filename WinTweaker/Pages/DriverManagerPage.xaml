<Page x:Class="WinTweaker.Pages.DriverManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource ThemeWindow}" Loaded="Page_Loaded">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Button Content="‹ Инструменты" HorizontalAlignment="Left" Padding="12,8" Click="BackToToolsButton_Click"/>
            <TextBlock Text="Драйверы и устройства" Foreground="{DynamicResource ThemeText}" FontSize="30" FontWeight="Bold" Margin="0,12,0,16"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="RefreshButton" Content="Обновить" Padding="16,10" Margin="0,0,10,8" Click="RefreshDriversButton_Click"/>
            <CheckBox x:Name="ProblemFilter" Content="Только проблемные" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center" Margin="0,0,18,8" Checked="ProblemFilter_Changed" Unchecked="ProblemFilter_Changed"/>
            <Button Content="Диспетчер устройств" Padding="16,10" Margin="0,0,0,8" Click="OpenDeviceManagerButton_Click"/>
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="InventoryStatus" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="WarningsText" Foreground="#FFD28A" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <DataGrid x:Name="DriversGrid" Grid.Row="3" Background="{DynamicResource ThemeCard}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowBackground="{DynamicResource ThemeCard}" AlternatingRowBackground="{DynamicResource ThemeControl}" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource ThemeBorder}" MinHeight="150" AutomationProperties.Name="Список устройств и драйверов">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource ThemeControl}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                    <Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Устройство" Binding="{Binding Device}" Width="2*"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding Provider}" Width="*"/>
                <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="*"/>
                <DataGridTextColumn Header="INF" Binding="{Binding InfName}" Width="*"/>
                <DataGridTextColumn Header="Статус Windows" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="Экспортируются все OEM-пакеты из Driver Store. Встроенные драйверы Windows не входят в копию; её полнота независимо не проверяется." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Button x:Name="ExportButton" Content="Экспорт всех OEM-пакетов" HorizontalAlignment="Left" Padding="16,10" Click="ExportOemDriversButton_Click"/>
            <TextBlock x:Name="ExportNotice" Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
            <TextBox x:Name="ExportStatus" Margin="0,10,0,0" MinHeight="55" MaxHeight="130" Background="{DynamicResource ThemeCard}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeBorder}" Padding="8" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Результат экспорта"/>
        </StackPanel>
    </Grid>
</Page>
