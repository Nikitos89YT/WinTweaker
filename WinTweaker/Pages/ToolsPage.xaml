<Page x:Class="WinTweaker.Pages.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F1115">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30">

            <!-- HEADER -->

            <TextBlock Text="Инструменты"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Диагностика и обслуживание Windows."
                       FontSize="14"
                       Foreground="#7F8796"
                       Margin="0,7,0,30"/>


            <!-- ================================================= -->
            <!-- DISK CHECK -->
            <!-- ================================================= -->

            <Border Background="#181C23"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock Text="💾 Проверка диска"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Проверка файловой системы и исправление ошибок."
                               FontSize="13"
                               Foreground="#8E96A5"
                               Margin="0,7,0,20"/>

                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="CheckDiskButton"
                                Content="Проверить"
                                Width="130"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="CheckDiskButton_Click"/>

                        <Button x:Name="RepairDiskButton"
                                Content="Проверить и исправить"
                                Width="180"
                                Height="40"
                                Click="RepairDiskButton_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- SFC / DISM -->
            <!-- ================================================= -->

            <Border Background="#181C23"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock Text="🛡 Проверка Windows"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Проверка и восстановление системных компонентов Windows."
                               FontSize="13"
                               Foreground="#8E96A5"
                               Margin="0,7,0,20"/>


                    <WrapPanel>

                        <Button Content="SFC /scannow"
                                Width="140"
                                Height="40"
                                Margin="0,0,10,10"
                                Click="SfcButton_Click"/>

                        <Button Content="DISM /CheckHealth"
                                Width="150"
                                Height="40"
                                Margin="0,0,10,10"
                                Click="DismCheckHealthButton_Click"/>

                        <Button Content="DISM /ScanHealth"
                                Width="150"
                                Height="40"
                                Margin="0,0,10,10"
                                Click="DismScanHealthButton_Click"/>

                        <Button Content="DISM /RestoreHealth"
                                Width="160"
                                Height="40"
                                Margin="0,0,10,10"
                                Click="DismRestoreHealthButton_Click"/>

                    </WrapPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- FULL WINDOWS CHECK -->
            <!-- ================================================= -->

            <Border Background="#181C23"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock Text="🧩 Комплексная проверка Windows"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Последовательно выполняет DISM и SFC."
                               FontSize="13"
                               Foreground="#8E96A5"
                               Margin="0,7,0,20"/>

                    <Button x:Name="FullRepairButton"
                            Content="Запустить комплексную проверку"
                            Width="230"
                            Height="40"
                            HorizontalAlignment="Left"
                            Click="FullRepairButton_Click"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- WINDOWS SERVICES -->
            <!-- ================================================= -->

            <Border Background="#181C23"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock Text="⚙ Службы Windows"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Управление службами Windows."
                               FontSize="13"
                               Foreground="#8E96A5"
                               Margin="0,7,0,20"/>

                    <Button Content="Открыть службы Windows"
                            Width="200"
                            Height="40"
                            HorizontalAlignment="Left"
                            Click="OpenServicesButton_Click"/>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- OUTPUT -->
            <!-- ================================================= -->

            <Border Background="#18181D"
                    BorderBrush="#303039"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="15"
                    Margin="0,0,0,25">

                <StackPanel>

                    <TextBlock Text="Вывод операции"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBox x:Name="OutputTextBox"
                             Text="Здесь будет отображаться результат выполнения операций."
                             Margin="0,12,0,0"
                             Height="220"
                             Background="#101116"
                             Foreground="#D8D8DE"
                             BorderBrush="#303039"
                             BorderThickness="1"
                             Padding="10"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Page>