<UserControl x:Class="WinTweaker.Components.TweakCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="110"
             Margin="0,0,0,12">

    <Border Background="{DynamicResource ThemeCard}"
            CornerRadius="12"
            Padding="20">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock x:Name="TitleText"
                           Text="Название твика"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ThemeText}"/>

                <TextBlock x:Name="DescriptionText"
                           Text="Описание твика"
                           FontSize="13"
                           Foreground="{DynamicResource ThemeMuted}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>

                <TextBlock x:Name="StatusText"
                           Text="● Не применено"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeMuted}"
                           Margin="0,7,0,0"/>

            </StackPanel>

            <Button x:Name="ActionButton"
                    Grid.Column="1"
                    Content="Применить"
                    Width="110"
                    Height="38"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ThemeControl}"
                    Foreground="{DynamicResource ThemeText}"
                    BorderThickness="0"
                    Click="ActionButton_Click"/>

        </Grid>

    </Border>

</UserControl>