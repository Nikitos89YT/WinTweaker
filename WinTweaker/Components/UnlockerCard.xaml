<UserControl x:Class="WinTweaker.Components.UnlockerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="115"
             Margin="0,0,0,12">

    <Border Background="#181C23"
            CornerRadius="12"
            Padding="22">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center">

                <TextBlock x:Name="TitleText"
                           Text="Название"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock x:Name="DescriptionText"
                           Text="Описание"
                           FontSize="13"
                           Foreground="#8E96A5"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>

                <TextBlock x:Name="StatusText"
                           Text="● Проверка..."
                           FontSize="13"
                           Foreground="#8E96A5"
                           Margin="0,7,0,0"/>

            </StackPanel>

            <Button x:Name="ActionButton"
                    Grid.Column="1"
                    Content="Проверить"
                    Width="135"
                    Height="40"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Background="#252A34"
                    Foreground="White"
                    BorderThickness="0"
                    Click="ActionButton_Click"/>

        </Grid>

    </Border>

</UserControl>